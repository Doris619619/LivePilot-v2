{
  "name": "livepilot-v2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3010",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3010",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "recover:lock": "node scripts/recover-lock.mjs",
    "setup:local": "node scripts/setup-local.mjs"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "obs-websocket-js": "5.0.8",
    "server-only": "0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "@types/node": "^22.18.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.3.3",
    "vitest": "^3.2.4"
  }
}