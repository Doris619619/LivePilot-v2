# 文件用途：Lightsail 单进程云端服务，不在云端启动 OBS。
[Unit]
Description=LivePilot cloud controller
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=livepilot
Group=livepilot
WorkingDirectory=/opt/livepilot/current
EnvironmentFile=/etc/livepilot/cloud.env
ExecStart=/usr/local/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3010
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
UMask=0077
[Install]
WantedBy=multi-user.target
