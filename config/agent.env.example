# 文件用途：复制到 .env.agent；令牌、OBS 密码与原加密密钥只保存在直播电脑。
LIVEPILOT_MODE=local
LIVEPILOT_ORIGIN=https://YOUR_CONTROLLER_IP
LIVEPILOT_AGENT_ID=studio_a
LIVEPILOT_INSTANCES=main
LIVEPILOT_DATA_ROOT=.data
# 已有本地服务必须保留原 DATA_ROOT、ENCRYPTION_KEY、实例 ID 和 OBS/媒体配置。
LIVEPILOT_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LIVEPILOT_OBS_EXE=
LIVEPILOT_OBS_WS_URL=ws://127.0.0.1:4455
LIVEPILOT_OBS_WS_PASSWORD=
LIVEPILOT_MEDIA_ROOT=
LIVEPILOT_PRIVACY=unlisted
LIVEPILOT_MADE_FOR_KIDS=false
