# Only use http://127.0.0.1:3010 in the browser. Never expose this server to a LAN.
LIVEPILOT_ORIGIN=http://127.0.0.1:3010

# Dedicated Portable OBS. Examples only; set your actual paths.
LIVEPILOT_OBS_EXE=D:\app\obs-portable-b\bin\64bit\obs64.exe
LIVEPILOT_OBS_WS_URL=ws://127.0.0.1:4455
LIVEPILOT_OBS_WS_PASSWORD=
LIVEPILOT_MEDIA_ROOT=D:\LiveMedia

# Google Cloud OAuth client type: Web application.
# Authorized redirect URI: http://127.0.0.1:3010/api/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LIVEPILOT_ENCRYPTION_KEY=

# Default unlisted. Set explicitly before creating broadcasts.
LIVEPILOT_PRIVACY=unlisted
LIVEPILOT_MADE_FOR_KIDS=false
