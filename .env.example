# LivePilot 本机配置模板；npm run setup:local 创建 .env.local 并生成加密密钥。
# Secret 只放 .env.local；所有改动保存后必须重启 LivePilot。
LIVEPILOT_ORIGIN=http://127.0.0.1:3010
# 一个实例只写 main；任意增加 ID，例如 main,obs_a,studio_c。不要改已有 ID。
LIVEPILOT_INSTANCES=main

# 主实例保留原版变量，原来的 .data/youtube.enc 与 control.json 继续有效。
LIVEPILOT_INSTANCE_MAIN_NAME=OBS B
LIVEPILOT_OBS_EXE=
LIVEPILOT_OBS_WS_URL=ws://127.0.0.1:4456
LIVEPILOT_OBS_WS_PASSWORD=
LIVEPILOT_MEDIA_ROOT=

# 启用第二实例：将上方列表改成 main,obs_a，并填写以下项。
# OBS A 例：D:\app\obs-portable-a\bin\64bit\obs64.exe
LIVEPILOT_INSTANCE_OBS_A_NAME=OBS A
LIVEPILOT_INSTANCE_OBS_A_OBS_EXE=
LIVEPILOT_INSTANCE_OBS_A_OBS_WS_URL=ws://127.0.0.1:4455
LIVEPILOT_INSTANCE_OBS_A_OBS_WS_PASSWORD=
# 可选：不填时共用 LIVEPILOT_MEDIA_ROOT。
LIVEPILOT_INSTANCE_OBS_A_MEDIA_ROOT=

# Google Cloud > Google Auth Platform > Clients > Web application
# 同一个 OAuth 客户端供所有实例使用，每个实例在网页分别授权不同频道。
# Authorized redirect URI: http://127.0.0.1:3010/api/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# setup:local 自动生成。存在加密授权时不要更换本机密钥。
LIVEPILOT_ENCRYPTION_KEY=

# 所有实例创建的新场次共用以下默认值；不改变已经创建的场次。
LIVEPILOT_PRIVACY=unlisted
LIVEPILOT_MADE_FOR_KIDS=false
